{
  "hosting": {
    "public": "hosting-public",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
          {"key": "Content-Security-Policy", "value": "frame-ancestors 'self'"}
        ]
      }
    ]
  }
}
